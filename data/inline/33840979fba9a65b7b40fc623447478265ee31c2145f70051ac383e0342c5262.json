      "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n  <head>\n    <meta name=\"color-scheme\" content=\"dark light\" />\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\" />\n    <title>Чёрно-белый мир</title>\n    <link\n      rel=\"stylesheet\"\n      href=\"https://code.s3.yandex.net/web-code/fonts/fonts.css\"\n    />\n    <link rel=\"stylesheet\" href=\"./styles/style.css\" />\n  </head>\n  <body>\n    <h1 class=\"title\">Следуй за белым кроликом!</h1>\n\n    <div class=\"something\"></div>\n\n    <div class=\"theme-toggler\">\n      <label class=\"theme-toggler__item\">\n        <input\n          class=\"theme-toggler__control theme-toggler__control_type_light\"\n          type=\"radio\"\n          name=\"theme-scheme\"\n          value=\"light\"\n        />\n        Светлая\n      </label>\n      <label class=\"theme-toggler__item\">\n        <input\n          class=\"theme-toggler__control theme-toggler__control_type_auto\"\n          type=\"radio\"\n          name=\"theme-scheme\"\n          value=\"auto\"\n          checked\n        />\n        Авто\n      </label>\n      <label class=\"theme-toggler__item\">\n        <input\n          class=\"theme-toggler__control theme-toggler__control_type_dark\"\n          type=\"radio\"\n          name=\"theme-scheme\"\n          value=\"dark\"\n        />\n        Тёмная\n      </label>\n    </div>\n  </body>\n</html>\n"
