      "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Поля формы</title>\n    <link\n      rel=\"stylesheet\"\n      href=\"https://code.s3.yandex.net/web-code/fonts/fonts.css\"\n    />\n    <link rel=\"stylesheet\" href=\"./styles/style.css\" />\n  </head>\n  <body>\n    <form action=\"submit\" class=\"main\">\n      <h2 class=\"question\">Когда легче концентрироваться?</h2>\n      <fieldset class=\"concentration\">\n        <div>\n          <!-- добавьте ↓ name=\"concentration\" value=\"morn\" -->\n          <input type=\"radio\" id=\"morn\" name=\"concentration\" value=\"morn\" />\n          <label for=\"morn\">Утром</label>\n        </div>\n        <div>\n          <!-- задайте такое же имя, но другое значение -->\n          <input type=\"radio\" id=\"day\" name=\"concentration\" value=\"day\" />\n          <label for=\"day\">Днём</label>\n        </div>\n        <div>\n          <!-- задайте такое же имя, но другое значение -->\n          <input type=\"radio\" id=\"evn\" name=\"concentration\" value=\"evn\" />\n          <label for=\"evn\">Вечером</label>\n        </div>\n        <div>\n          <!-- задайте такое же имя, но другое значение -->\n          <input type=\"radio\" id=\"night\" name=\"concentration\" value=\"night\" />\n          <label for=\"night\">Ночью</label>\n        </div>\n      </fieldset>\n      <button type=\"submit\">Поделиться</button>\n    </form>\n  </body>\n</html>\n"
    }
