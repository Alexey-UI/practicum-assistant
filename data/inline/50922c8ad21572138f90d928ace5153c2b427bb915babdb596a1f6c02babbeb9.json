      "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\" />\n    <title>Контейнеры</title>\n    <link\n      rel=\"stylesheet\"\n      href=\"https://code.s3.yandex.net/web-code/fonts/fonts.css\"\n    />\n    <link rel=\"stylesheet\" href=\"./styles/style.css\" />\n  </head>\n  <body class=\"page\">\n    <header class=\"header\">\n      <h1 class=\"header__title\">Выбери свою Тардис:</h1>\n      <button class=\"menu\" aria-label=\"Открыть меню\"></button>\n    </header>\n    <main class=\"content\">\n      <ul class=\"cards\">\n        <li class=\"cards__item\">\n          <article class=\"card card_size_xl\">\n            <img\n              class=\"card__img\"\n              src=\"./images/12.jpg\"\n              alt=\"Консольная комната тардис в тёмных тонах\"\n            />\n            <div class=\"card__content\">\n              <p class=\"card__text\">\n                Cовершенно новый уровень космического дизайна! Тёмные тона и\n                белый свет лампочек создают уникальный контраст и создают\n                ощущение, что вы находитесь в самом центре космической станции,\n                готовой отправиться в захватывающее путешествие.\n              </p>\n              <button class=\"card__add-button\">\n                Беру!\n                <span class=\"card__more\">Дайте две!</span>\n              </button>\n            </div>\n          </article>\n        </li>\n        <li class=\"cards__item\">\n          <article class=\"card card_size_l\">\n            <img\n              class=\"card__img\"\n              src=\"./images/11.jpg\"\n              alt=\"Консольная комната тардис в оранжевых тонах\"\n            />\n            <div class=\"card__content\">\n              <p class=\"card__text\">\n                Стиль, сочетающий в себе чёткие линии и глубокие оранжевые тона,\n                создает уникальную атмосферу захватывающего путешествия во\n                времени и пространстве.\n              </p>\n              <button class=\"card__add-button\">\n                Беру!\n                <span class=\"card__more\">Дайте две!</span>\n              </button>\n            </div>\n          </article>\n        </li>\n        <li class=\"cards__item\">\n          <article class=\"card card_size_m\">\n            <img\n              class=\"card__img\"\n              src=\"./images/13.jpg\"\n              alt=\"Консольная комната тардир в сине-жёлто-оранжевых тонах\"\n            />\n            <div class=\"card__content\">\n              <p class=\"card__text\">\n                Яркий красочный интерьер с контрастами кобальтового синего и\n                жёлто-оранжевого.\n              </p>\n              <button class=\"card__add-button\">\n                Беру!\n                <span class=\"card__more\">Дайте две!</span>\n              </button>\n            </div>\n          </article>\n        </li>\n      </ul>\n    </main>\n\n    <aside class=\"sidebar\">\n      <h2 class=\"sidebar__title\">Другие варианты:</h2>\n      <ul class=\"other-goods\">\n        <li class=\"cards__item\">\n          <article class=\"card card_size_s card_type_white\">\n            <img\n              class=\"card__img\"\n              src=\"./images/10.jpg\"\n              alt=\"Консольная комната тардис в медово-жёлтых тонах\"\n            />\n            <div class=\"card__content\">\n              <p class=\"card__text\">\n                Медово-жёлтые тона создают тёплую и уютную атмосферу,\n                заставляющую расслабиться и наслаждаться путешествием.\n              </p>\n              <button class=\"card__add-button\">\n                Беру!\n                <span class=\"card__more\">Дайте две!</span>\n              </button>\n            </div>\n          </article>\n        </li>\n      </ul>\n    </aside>\n\n    <footer class=\"footer\"></footer>\n    <script src=\"./scripts/script.js\"></script>\n  </body>\n</html>\n"
    }
