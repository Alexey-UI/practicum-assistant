      "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Кастомные элементы формы</title>\n    <link\n      rel=\"stylesheet\"\n      href=\"https://code.s3.yandex.net/web-code/fonts/fonts.css\"\n    />\n    <link rel=\"stylesheet\" href=\"./styles/style.css\" />\n  </head>\n  <body>\n    <form>\n      <fieldset>\n        <label>\n          <input class=\"visually-hidden\" type=\"radio\" name=\"answer\" />\n          <span></span>\n          Да\n        </label>\n        <label>\n          <input class=\"visually-hidden\" type=\"radio\" name=\"answer\" />\n          <span></span>\n          Нет\n        </label>\n        <label>\n          <input class=\"visually-hidden\" type=\"radio\" name=\"answer\" />\n          <span></span>\n          Не знаю\n        </label>\n      </fieldset>\n      <fieldset>\n        <label>\n          <input class=\"visually-hidden\" type=\"checkbox\" name=\"tv-show\" />\n          <span></span>\n          Новости\n        </label>\n        <label>\n          <input class=\"visually-hidden\" type=\"checkbox\" name=\"tv-show\" />\n          <span></span>\n          Фантастика\n        </label>\n        <label>\n          <input class=\"visually-hidden\" type=\"checkbox\" name=\"tv-show\" />\n          <span></span>\n          Мультики\n        </label>\n      </fieldset>\n      <fieldset>\n        <select name=\"cartoon\">\n          <option value=\"\">История игрушек</option>\n          <option value=\"\">Мулан</option>\n          <option value=\"\">Король Лев</option>\n        </select>\n      </fieldset>\n      <button>Ответить</button>\n    </form>\n  </body>\n</html>\n"
