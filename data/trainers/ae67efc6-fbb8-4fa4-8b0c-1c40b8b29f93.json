  "taskId": "ae67efc6-fbb8-4fa4-8b0c-1c40b8b29f93",
  "lessonId": "daad20ea-1391-4d23-8f9c-3a26d3b97c65",
  "contextHash": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
