      "initialHash": "4103728916146571613d276a0fb3a8abd7142f93f44d6f39ab46f8baf9e217d2",
      "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Формы ввода и шрифты</title>\n  <link rel=\"stylesheet\" href=\"https://code.s3.yandex.net/web-code/normalize.css\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <div class=\"page\">\n    <section class=\"form\">\n      <div class=\"form__toggle\">\n        <img class=\"form__toggle-image\" src=\"https://pictures.s3.yandex.net/html-forms/close_icon.png\">\n      </div>\n      <div class=\"form__container\">\n        <form class=\"form__admin\">\n          <div class=\"form__main-container\">\n            <h2 class=\"form__heading\">Задайте параметры</h2>\n            <fieldset class=\"form__input-container form__input-container_ctrl_texts\">\n              <label for=\"heading\" class=\"form__label\">Заголовок</label>\n              <input type=\"text\" class=\"form__item form__item_el_heading\" id=\"heading\" name=\"heading\">\n              <label for=\"subheading\" class=\"form__label\">Подзаголовок</label>\n              <input type=\"text\" class=\"form__item form__item_el_subheading\" id=\"subheading\" name=\"subheading\">\n              <label for=\"main-text\" class=\"form__label\">Текст статьи</label>\n              <textarea class=\"form__item form__item_el_main-text\" id=\"main-text\" name=\"main-text\"></textarea>\n              <label for=\"email\" class=\"form__label\">E-mail</label>\n              <input type=\"email\" class=\"form__item form__item_el_email\" id=\"email\" name=\"email\">\n            </fieldset>\n            <div class=\"form__line\"></div>\n            <fieldset class=\"form__input-container form__input-container_ctrl_visual\">\n              <label for=\"font-family\" class=\"form__label\">Семейство шрифтов</label>\n              <select class=\"form__item form__item_el_font-family\" id=\"font-family\" name=\"font-family\">\n                <option value=\"ibm\">IBM Plex Serif</option>\n                <option value=\"ubuntu\">Ubuntu</option>\n                <option value=\"istok\">Istok Web</option>\n              </select>\n              <label for=\"heading-font-size\" class=\"form__label\">Размер текста заголовка</label>\n              <input type=\"number\" class=\"form__item form__item_el_heading-fontsize\" min=\"24\" max=\"80\" id=\"heading-font-size\" name=\"heading-font-size\" value=\"32\">\n              <label for=\"text-font-size\" class=\"form__label\">Размер текста абзаца</label>\n              <input type=\"number\" class=\"form__item form__item_el_text-fontsize\" min=\"12\" max=\"40\" id=\"text-font-size\" name=\"text-font-size\" value=\"24\">\n              <label for=\"pub-date\" class=\"form__label\">Дата создания статьи</label>\n              <input type=\"date\" class=\"form__item form__item_el_pubdate\" id=\"pub-date\" name=\"pub-date\">\n              <label for=\"image\" class=\"form__label\">Обложка статьи</label>\n              <select class=\"form__item form__item_el_image\" id=\"image\" name=\"image\">\n                <option value=\"bombardier\">Bombardier CS300</option>\n                <option value=\"hobbit\">Боинг-777 Хоббит</option>\n                <option value=\"tiger\">Тигролёт</option>\n                <option value=\"connected\">Connected to 01000010 01001100 01010101 01000101</option>\n                </select>\n            </fieldset>\n            <fieldset class=\"form__input-container form__input-container_ctrl_additional\">\n              <h3 class=\"form__heading form__heading_type_ctrl-el-heading\">Количество колонок</h3>\n              <input type=\"radio\" name=\"number-of-columns\" id=\"one-column\" class=\"form__item form__item_el_number-of-columns\" value=\"one-column\" checked>\n              <label for=\"one-column\" class=\"form__label form__label_direction_right\">1</label>\n              <input type=\"radio\" name=\"number-of-columns\" id=\"two-columns\" class=\"form__item form__item_el_number-of-columns\" value=\"two-columns\">\n              <label for=\"two-columns\" class=\"form__label form__label_direction_right\">2</label>\n              <label for=\"text-color\" class=\"form__label\">Цвет текста</label>\n              <input type=\"color\" class=\"form__item form__item_el_text-color\" id=\"text-color\" name=\"text-color\" value=\"#979797\">\n              <label for=\"content-width\" class=\"form__label\">Ширина контента</label>\n              <input type=\"range\" class=\"form__item form__item_el_content-width\" min=\"30\" max=\"80\" step=\"10\" id=\"content-width\" name=\"content-width\">\n              <h3 class=\"form__heading form__heading_type_ctrl-el-heading\">Дополнительные параметры</h3>\n              <input type=\"checkbox\" name=\"extra-option\" id=\"black-background\" class=\"form__item form__item_el_extra-options\" value=\"black-background\">\n              <label for=\"black-background\" class=\"form__label form__label_direction_right\">Чёрный фон</label>\n              <input type=\"checkbox\" name=\"extra-option\" id=\"bold-heading\" class=\"form__item form__item_el_extra-options\" value=\"bold-heading\" checked>\n              <label for=\"bold-heading\" class=\"form__label form__label_direction_right\">Жирный заголовок</label>\n            </fieldset>\n          </div>\n          <fieldset class=\"form__handlers\">\n              <input type=\"submit\" class=\"form__button\">\n              <input type=\"reset\" class=\"form__button\">\n          </fieldset>\n        </form>\n      </div>\n    </section>\n    <section class=\"content\">\n      <div class=\"content__container\">\n        <header class=\"content__header\">\n          <h1 class=\"content__heading\">Портрет Западной Швейцарии</h1>\n          <h2 class=\"content__subheading\">Примитивист Фиштр расписывает новый бюджетный авиалайнер</h2>\n        </header>\n        <div class=\"content__image\">\n          <img class=\"content__image-item\" src=\"https://pictures.s3.yandex.net/html-forms/BOMBARDIER.jpg\">\n          <div class=\"content__image-copyright\">\n            Фото:\n            <a class=\"content__link\" href=\"https://www.flickr.com/photos/sloppyperfectionist/35863293766/\" target=\"_blank\">\n              Hans-Peter Gauster\n            </a>\n            , \"Bombardier CSeries CS300 HB-JCA\" © 2017\n            <a class=\"content__link\" href=\"https://creativecommons.org/licenses/by-sa/2.0/legalcode\" target=\"_blank\">\n              CC BY-SA 2.0\n            </a>\n            &nbsp;&nbsp;\n            <img src=\"https://pictures.s3.yandex.net/html-forms/BOMBARDIER_CC.svg\" alt=\"\" height=\"10\">\n          </div>\n        </div>\n        <div class=\"content__text\">\n          <p class=\"content__paragraph\">\n            В конце 2016 года швейцарская авиакомпания Swiss получила свой первый канадский «Бомбардье CS300»\n            для полётов малой и средней дальности. Чтобы придать новой 145-местной машине неповторимую индивидуальность,\n            ливрею заказали живописцу. При условии, что эскиз он выполнит в одиночку и лично поправит роспись,\n            когда её будут наносить на фюзеляж.\n          </p>\n          <p class=\"content__paragraph\">\n            Выбор пал на примитивиста Матиаса Форбаша, работающего под псевдонимом Фиштр. Ему поставили задачу\n            изобразить всё лучшее во франкоговорящей части Швейцарии — горы, озёра, вина, сыры, доброжелательность\n            и свободу. Заказ был выполнен в рекордный срок, всего за 5 месяцев. Самолёт получился похожим на самого\n            художника: такой же добродушный и с улыбкой до ушей.\n          </p>\n          <p class=\"content__paragraph\">\n            С мая 2017 года \"Бомбардье\" носит имя \"Швейцарская Романдия\" и регистрационный номер\n            <a class=\"content__link\" href=\"https://www.flightradar24.com/data/aircraft/hb-jca\" target=\"_blank\">\n              HB-JCA\n            </a>\n            ; совершает в среднем 4 коммерческих полёта в сутки. Его можно видеть в \"Домодедово\", а также в аэропортах\n            Парижа, Валенсии, Кракова, Берлина, Вены, Загреба, на Майорке, Крите и Сицилии. Самолёт останется в той же\n            ливрее, пока его не купит другая авиакомпания.\n          </p>\n        </div>\n        <div class=\"content__date\">10.10.18</div>\n        <div class=\"content__author\">\n          Пишите автору на\n          <a class=\"content__link content__link_type_email\" href=\"mailto:mshifrin@yandex-team.ru\">\n            mshifrin@yandex-team.ru\n          </a>\n        </div>\n      </div>\n    </section>\n    <footer class=\"footer\">\n      <div class=\"footer__container\"></div>\n    </footer>\n  </div>\n</body>\n</html>\n"
    }
  ],
